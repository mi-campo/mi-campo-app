# Copiar este archivo a ".env" (sin el .example) y completar los valores reales.
# El .env real NUNCA se sube a GitHub (tiene claves privadas) — vive solo en el servidor.

# --- WhatsApp Business API (Meta) ---
# Se generan en developers.facebook.com → tu app → WhatsApp → API Setup / Configuración
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cualquier palabra que elijas — tiene que coincidir con la que pongas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=

# --- Anthropic (IA) ---
# Se genera en console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# --- Servidor ---
PORT=3000
# Clave random para las sesiones de login — generarla una vez con: openssl rand -hex 32
SESSION_SECRET=

# --- Resumen diario por WhatsApp (opcional) ---
# Tu número de WhatsApp (con 549 adelante), a donde se manda el resumen automático lun-sáb 7am.
# Si se deja vacío, el script resumenDiario.js no funciona pero el resto del sistema sigue igual.
RESUMEN_DIARIO_NUMERO=
